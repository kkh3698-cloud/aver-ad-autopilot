# 네이버 검색광고 API — searchad.naver.com > 도구 > API 사용 관리
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# 네이버 오픈API (지역검색) — developers.naver.com > 애플리케이션 등록 > 검색
NAVER_OPENAPI_CLIENT_ID=
NAVER_OPENAPI_CLIENT_SECRET=

# 광고 문구 생성 (선택) — console.anthropic.com
ANTHROPIC_API_KEY=

# 업계 인기 유튜브 수집 (선택) — Google Cloud 콘솔 > YouTube Data API v3
YOUTUBE_API_KEY=

# 알림 (선택)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
